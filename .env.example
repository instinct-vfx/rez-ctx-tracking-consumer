# Overrides for docker-compose.yml. Copy to .env and adjust; every value here
# is the default used when .env is absent. .env is git-ignored.

# PostgreSQL
POSTGRES_DB=rez
POSTGRES_USER=rez
POSTGRES_PASSWORD=rez
POSTGRES_PORT=5432            # host port

# RabbitMQ
RABBITMQ_USER=rez
RABBITMQ_PASSWORD=rez
RABBITMQ_PORT=5672            # host port, for rez's context_tracking_host
RABBITMQ_MANAGEMENT_PORT=15672

# Consumer
LOG_LEVEL=INFO
LOG_FORMAT=text               # json for log shippers
METRICS_PORT=9100             # host port for /healthz and /metrics
# Map rez context_tracking_extra_fields to columns (add the columns first):
# EXTRA_FIELD_COLUMNS={"show": "show"}
